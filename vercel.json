{
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'self'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self'; upgrade-insecure-requests"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
                }
            ]
        },
        {
            "source": "/assets/images/optimized/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/assets/styles/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/assets/scripts/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "ebnul-hasan-mahi-portfolio.vercel.app"
                }
            ],
            "destination": "https://www.ebnulhasanmahi.me/:path*",
            "permanent": true
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "ebnulhasanmahi.bro.bd"
                }
            ],
            "destination": "https://www.ebnulhasanmahi.me/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/robots.txt",
            "destination": "/seo/robots.txt"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/seo/sitemap.xml"
        },
        {
            "source": "/resume",
            "destination": "/resume/index.html"
        },
        {
            "source": "/resume.html",
            "destination": "/resume/index.html"
        },
        {
            "source": "/projects/dr-momenul-islam",
            "destination": "/projects/dr-momenul-islam/index.html"
        },
        {
            "source": "/projects/dr-momenul-islam.html",
            "destination": "/projects/dr-momenul-islam/index.html"
        },
        {
            "source": "/projects",
            "destination": "/projects/index.html"
        },
        {
            "source": "/about",
            "destination": "/about/index.html"
        },
        {
            "source": "/((?!assets/|seo/|api/|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}
